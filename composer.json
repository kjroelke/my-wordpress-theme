{
	"name": "kjroelke/kjr-wp-theme",
	"description": "My WordPress theme",
	"type": "project",
	"version": "3.1.0",
	"authors": [
		{
			"name": "kjroelke",
			"email": "kj.roelke@gmail.com"
		}
	],
	"autoload": {
		"classmap": [
			"inc/"
		]
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*",
				"wpackagist-theme/*"
			]
		}
	],
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "*"
	},
	"scripts": {
		"phpcs": "phpcs . --extensions=php --ignore=/dist/",
		"phpcbf": "phpcbf . --extensions=php --ignore=/dist/"
	}
}
