{
	"name": "kjr-wp-theme",
	"version": "3.0.0",
	"description": "My custom wordpress theme for my personal site",
	"main": "src/index.ts",
	"prettier": "@wordpress/prettier-config",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"scripts": {
		"build": "wp-scripts build --config=webpack.config.mjs",
		"check-engines": "wp-scripts check-engines",
		"packages-update": "wp-scripts packages-update",
		"start": "wp-scripts start --config=webpack.config.mjs",
		"lint:css": "npx stylelint '**/*.scss' '**/*.css' --fix",
		"lint:js": "npx eslint --fix"
	},
	"author": "KJ Roelke",
	"license": "ISC",
	"devDependencies": {
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/scripts": "^36.1.0",
		"baseline-browser-mapping": "^2.11.29",
		"eslint": "^9",
		"globals": "^17.13.0",
		"prettier": "npm:wp-prettier@^v3",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-scss": "^7.3.0",
		"typescript": "^6"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"fsevents@2.3.3": true,
		"unrs-resolver@1.12.2": true,
		"core-js@3.51.0": true,
		"core-js-pure@3.51.0": true
	},
	"dependencies": {
		"@choctawnationofoklahoma/wp-flex-reverse-toggle": "^1.1.4"
	}
}
